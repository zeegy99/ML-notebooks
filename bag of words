      "source": [
        "#Feeding into a neural network\n",
        "xs = []\n",
        "ys = []\n",
        "\n",
        "for word in names:\n",
        "  chars = ['.'] + list(word) + ['.']\n",
        "  for ch1, ch2 in zip(chars, chars[1:]):\n",
        "    if ch1 == '.':\n",
        "      ch1 = 0\n",
        "    else:\n",
        "      ch1 = ord(ch1) - 96\n",
        "    if ch2 == '.':\n",
        "      ch2 = 0\n",
        "    else:\n",
        "      ch2 = ord(ch2) - 96\n",
        "    xs.append(ch1)\n",
        "    ys.append(ch2)\n",
        "\n",
        "xs = torch.tensor(xs)\n",
        "ys = torch.tensor(ys)\n",
        "num = xs.nelement()\n",
        "print('number elements: ', num)\n",
        "\n",
        "g = torch.Generator().manual_seed(2147483647)\n",
        "W = torch.randn((27, 27), generator = g, requires_grad=True)"
      ],
